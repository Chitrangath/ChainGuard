# ChainGuard Environment Configuration
# =====================================

# Host development (worker + local dev server)
# PostgreSQL: use port 5433 if existing guardrails-postgres is on 5432
# Redis: use port 6379
DATABASE_URL="postgresql://guardrails:guardrails_dev@localhost:5433/guardrails?schema=public"
REDIS_URL="redis://localhost:6379"

# Compose app (internal URLs, overridden by docker-compose.yml)
# DATABASE_URL="postgresql://guardrails:guardrails_dev@postgres:5432/guardrails?schema=public"
# REDIS_URL="redis://redis:6379"

# Worker secret (change in production)
WORKER_SECRET="change-me-in-production"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
