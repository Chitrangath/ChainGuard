generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id            String     @id @default(cuid())
  name          String
  repositoryUrl String
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  analyses      Analysis[]

  @@map("projects")
}

model Analysis {
  id                      String                   @id @default(cuid())
  projectId               String
  status                  AnalysisStatus           @default(QUEUED)
  riskScore               Int?
  deploymentStatus        DeploymentStatus?
  compilationStatus       CompilationStatus?
  testStatus              TestStatus?
  totalTests              Int?
  passedTests             Int?
  failedTests             Int?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime                 @default(now())
  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings                Finding[]
  projectType             ProjectType?
  compilerVersion         String?
  contractsDiscovered     Int?
  contractsCompiled       Int?
  contractsTargetedForScan Int?
  securityAnalysisStatus  SecurityAnalysisStatus?
  gateReasons             String[]
  coverage                AnalysisCoverage?

  @@map("analyses")
}

model Finding {
  id          String   @id @default(cuid())
  analysisId  String
  severity    Severity
  type        String
  contract    String?
  file        String?
  line        Int?
  description String
  source      String
  createdAt   DateTime @default(now())
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("findings")
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED

  @@map("analysis_status")
}

enum DeploymentStatus {
  READY
  BLOCKED

  @@map("deployment_status")
}

enum CompilationStatus {
  PASS
  FAIL
  NOT_RUN
  UNSUPPORTED

  @@map("compilation_status")
}

enum TestStatus {
  PASS
  FAIL
  NO_TESTS
  NOT_RUN
  ERROR

  @@map("test_status")
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW

  @@map("severity")
}

enum ProjectType {
  FOUNDRY
  HARDHAT
  TRUFFLE
  STANDALONE_SOLIDITY
  UNKNOWN_SOLIDITY

  @@map("project_type")
}

enum SecurityAnalysisStatus {
  PASS
  FAIL
  NOT_RUN
  UNSUPPORTED
  NO_CONTRACTS_FOUND

  @@map("security_analysis_status")
}

enum AnalysisCoverage {
  FULL
  PARTIAL
  FAILED

  @@map("analysis_coverage")
}
