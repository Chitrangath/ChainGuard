generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id            String     @id @default(cuid())
  name          String
  repositoryUrl String
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  analyses      Analysis[]

  @@map("projects")
}

model Analysis {
  id                String             @id @default(cuid())
  projectId         String
  status            AnalysisStatus     @default(QUEUED)
  riskScore         Int?
  deploymentStatus  DeploymentStatus?
  compilationStatus CompilationStatus?
  testStatus        TestStatus?
  totalTests        Int?
  passedTests       Int?
  failedTests       Int?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings          Finding[]

  @@map("analyses")
}

model Finding {
  id          String   @id @default(cuid())
  analysisId  String
  severity    Severity
  type        String
  contract    String?
  file        String?
  line        Int?
  description String
  source      String
  createdAt   DateTime @default(now())
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("findings")
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED

  @@map("analysis_status")
}

enum DeploymentStatus {
  READY
  BLOCKED

  @@map("deployment_status")
}

enum CompilationStatus {
  PASS
  FAIL

  @@map("compilation_status")
}

enum TestStatus {
  PASS
  FAIL

  @@map("test_status")
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW

  @@map("severity")
}
